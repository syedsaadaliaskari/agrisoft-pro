# Supabase (cloud sync) — copy to .env and fill real values
# Project URL: https://vbyqlfxcfxijmrvilupp.supabase.co
# One project = main server for ALL shops. Each company gets its own tenants.id.

NEXT_PUBLIC_SUPABASE_URL=https://vbyqlfxcfxijmrvilupp.supabase.co

# anon / public key (Settings → API Keys)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role / secret key — desktop sync only, NEVER ship in a public mobile app
SUPABASE_SERVICE_ROLE_KEY=

# Optional DEV/VENDOR fallback only. Real shops get their cloud shop ID from the
# Pro activation code (stored as settings.supabase_tenant_id). Prefer leaving this
# as tenant-dev-001 for your own test PC.
SUPABASE_TENANT_ID=tenant-dev-001
